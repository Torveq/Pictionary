0004025C: 19C38393    ; 
00040260: 006383B3    ;                 add     t2, t2, t1
00040264: 00038023    ;                 sb      zero, 0[t2]
00040268: 00100513    ;                 li      a0, 1               ; Message ready!
0004026C:             ; 
0004026C:             ; comm_poll_exit
0004026C: 00012083    ;                 lw      ra, 0[sp]
00040270: 00412403    ;                 lw      s0, 4[sp]
00040274: 01010113    ;                 addi    sp, sp, 16
00040278: 00008067    ;                 ret
0004027C:             ; 
0004027C:             ; ; --- Subroutine: comm_send_message ---
0004027C:             ; ; Arguments: None (uses internal tx_buffer)
0004027C:             ; ; Side effects: Overwrites a0, a7, t0, t1. Preserves ra, s1, s2, s3.
0004027C:             ; ; Description: Sends a buffer followed by a newline via UART.
0004027C:             ; comm_send_message
0004027C: FF010113    ;                 subi    sp, sp, 16
00040280: 00112023    ;                 sw      ra, 0[sp]
