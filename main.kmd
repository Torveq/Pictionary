0004099C:             ; FALSE           EQU     0
0004099C:             ; 
0004099C:             ; ; System Register Masks
0004099C:             ; MSTATUS_MPP_MASK EQU    0x1800
0004099C:             ; MSTATUS_MPIE_MIE_MASK EQU    0x0088
0004099C:             ; MIE_MEI_MASK     EQU    0x0800
0004099C:             ; MCAUSE_MASK      EQU    0x0F
0004099C:             ; 
0004099C:             ; 
0004099C:             ; ; Hardware Base Addresses
0004099C:             ; LCD_BASE        EQU     0x00010100
0004099C:             ; LCD_DATA        EQU     0x0
0004099C:             ; LCD_CTRL        EQU     0x1
0004099C:             ; TIMER_BASE      EQU     0x00010200
0004099C:             ; BUTTON_PORT     EQU     0x00010000
0004099C:             ; HALT_PORT       EQU     0x00010700
0004099C:             ; SYS_CTRL_BASE   EQU     0x00010700
0004099C:             ; PIN_FN_REG      EQU     0x08
0004099C:             ; LED_FN_REG      EQU     0x0C
0004099C:             ; INT_CONTROL     EQU     0x00010400
0004099C:             ; INT_EN_OFFSET   EQU     0x04
0004099C:             ; INT_REQ_OFFSET  EQU     0x08
0004099C:             ; 
0004099C:             ; ; VDU Peripheral Addresses
0004099C:             ; VDU_BASE        EQU     0x00010600
0004099C:             ; VDU_SCREEN_BASE EQU     0x0
0004099C:             ; VDU_MODE        EQU     0x4
0004099C:             ; 
0004099C:             ; ; User Peripheral Addresses
0004099C:             ; USER_UART_BASE  EQU     0x0002_0000
0004099C:             ; UART_DATA       EQU     0x00
0004099C:             ; UART_STAT       EQU     0x04
0004099C:             ; UART_BAUD       EQU     0x08
0004099C:             ; UART_BUZ        EQU     0x0C
0004099C:             ; 
0004099C:             ; ; UART Status/Control Bits
0004099C:             ; UART_RX_RDY     EQU     0x01
0004099C:             ; UART_RX_ERR     EQU     0x02
0004099C:             ; UART_TX_RDY     EQU     0x10
0004099C:             ; UART_RX_ERR_IE  EQU     0x03    ; RX + RX_ERR Interrupt Enable
0004099C:             ; UART_FULL_IE    EQU     0x13    ; RX + RX_ERR + TX Interrupt Enable
0004099C:             ; 
0004099C:             ; ; Interrupt Controller Bits
0004099C:             ; INT_RX_BIT      EQU     0x01
0004099C:             ; INT_TX_BIT      EQU     0x02
0004099C:             ; INT_ERR_BIT     EQU     0x04
0004099C:             ; UART_ERR_BIT    EQU     0x04
0004099C:             ; INT_TIMER_BIT   EQU     0x10
0004099C:             ; TIMER_BIT_OFFSET EQU    0x10
0004099C:             ; INT_ALL_ENABLED EQU     0x07    ; UART RX/TX/ERR ONLY (Timer disabled for debug)
0004099C:             ; 
0004099C:             ; ; FIFO Configuration
0004099C:             ; FIFO_SIZE       EQU     128
0004099C:             ; FIFO_MASK       EQU     (FIFO_SIZE - 1)
0004099C:             ; 
0004099C:             ; ; System Configuration Masks
0004099C:             ; SYS_UART_PINS_MASK EQU  0xC0000000
0004099C:             ; SYS_BUZZER_PINS_MASK EQU 0x000000C0
0004099C:             ; SYS_LED_LCD_EXP_MASK EQU 0x2FF
0004099C:             ; 
