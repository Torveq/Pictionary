0004099C:             ; SYS_PRINT_CHAR   EQU    1
0004099C:             ; SYS_EXIT         EQU    2
0004099C:             ; SYS_TIMER_INIT   EQU    3
0004099C:             ; SYS_TIMER_CHECK  EQU    4
