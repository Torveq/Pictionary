000401DC:             ; ; --- Subroutine: comm_poll_message ---
000401DC:             ; ; Returns:   a0 = 1 if a full newline-terminated message is ready, 0 otherwise.
000401DC:             ; ; Side effects: Overwrites a0, a7, t0, t1, t2. Preserves ra, s0.
000401DC:             ; ; Description: Polls UART, appends to buffer, and checks for message completion.
000401DC:             ; comm_poll_message
000401DC: FF010113    ;                 subi    sp, sp, 16
000401E0: 00112023    ;                 sw      ra, 0[sp]
000401E4: 00812223    ;                 sw      s0, 4[sp]
000401E8:             ; 
000401E8:             ; comm_poll_loop
000401E8: 00A00893    ;                 li      a7, SYS_UART_GET
