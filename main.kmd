0004099C:             ; LCD_RS_CMD       EQU    0b0000
0004099C:             ; LCD_RS_DATA      EQU    0b0010
0004099C:             ; LCD_E_HIGH       EQU    0b0100
0004099C:             ; LCD_E_LOW        EQU    0b0000
