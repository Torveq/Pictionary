KMD
00000000:             ; ; ------------------------------------------------------------------------------
00000000:             ; ;           Exercise 9: Project Pictionary Game (charades but with drawings)
00000000:             ; ;           Mahmoud Alhasan
00000000:             ; ;           Version 3.0
00000000:             ; ;           16th May 2026
00000000:             ; ;
00000000:             ; ;           Implements a UART peripheral in Verilog to communicate serially 
00000000:             ; ;           via an HC-06 Bluetooth module to a connected device such as a
00000000:             ; ;           phone. Phone player can send commands to draw on the monitor,
00000000:             ; ;           and the board player can send guesses to the phone player.
00000000:             ; ;           Hardware access is strictly mediated through ECALL services.
00000000:             ; ;
00000000:             ; ;           ARCHITECTURE: Communication Manager Pattern
00000000:             ; ;           - main.s: High-level application controller.
00000000:             ; ;           - parser_lib.s: Command tokenization and dispatch.
00000000:             ; ;           - comm_lib.s: UART buffer management and message polling.
00000000:             ; ;           - keyboard_lib.s: Matrix translation and UI state management.
00000000:             ; ;
00000000:             ; ;           CLEVER MOVE: "Hot Path" Branch Optimization.
00000000:             ; ;           The loop is structured so the most frequent case (no keyboard input)
00000000:             ; ;           falls through directly into the UART polling logic. This saves 
00000000:             ; ;           one branch penalty per loop cycle, minimizing pipeline stalls.
00000000:             ; ; ------------------------------------------------------------------------------
00000000:             ; 
00000000:             ; ; ------------------------------------------------------------------------------
00000000:             ; ; Constants
00000000:             ; ; ------------------------------------------------------------------------------
00000000:             ; 
00000000:             ; LCD_CMD_CLEAR    EQU    1
00000000:             ; LCD_LINE1_START  EQU    0x80
00000000:             ; LCD_LINE2_START  EQU    0xC0
00000000:             ; 
00000000:             ; ASCII_SPACE      EQU    ' '
00000000:             ; ASCII_NEWLINE    EQU    '\n'
00000000:             ; 
00000000:             ; ; ECALL Service Numbers
00000000:             ; SYS_PRINT_CHAR   EQU    1
00000000:             ; SYS_EXIT         EQU    2
00000000:             ; SYS_TIMER_INIT   EQU    3
00000000:             ; SYS_TIMER_CHECK  EQU    4
00000000:             ; SYS_READ_BUTTONS EQU    5
00000000:             ; SYS_LCD_CMD      EQU    6
00000000:             ; SYS_LCD_CLEAR    EQU    7
00000000:             ; SYS_GET_KEY      EQU    8
00000000:             ; SYS_UART_PUT     EQU    9
00000000:             ; SYS_UART_GET     EQU    10
00000000:             ; SYS_BUZZER       EQU    11
00000000:             ; 
00000000:             ; ; ------------------------------------------------------------------------------
00000000:             ; ; User Application (User Mode)
00000000:             ; ; ------------------------------------------------------------------------------
00040000:             ;                 ORG     0x00040000          ; User RAM region
